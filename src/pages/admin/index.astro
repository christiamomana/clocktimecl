---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { hasDatabase } from '../../lib/server/db';
import { listRelojes, loadSeed, patchReloj } from '../../lib/server/relojes';
import { ESTADOS, estadoLabel, formatCLP } from '../../lib/relojes';

let msg = Astro.url.searchParams.get('ok') ?? '';
let error = '';

if (hasDatabase() && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion'));
  const id = Number(form.get('id'));
  try {
    if (accion === 'publicar' || accion === 'ocultar') {
      await patchReloj(id, { publicado: accion === 'publicar' });
      msg = accion === 'publicar' ? 'Reloj publicado.' : 'Reloj oculto.';
    } else if (accion === 'estado' && (ESTADOS as readonly string[]).includes(String(form.get('estado')))) {
      await patchReloj(id, { estado: String(form.get('estado')) });
      msg = 'Estado actualizado.';
    } else if (accion === 'seed') {
      const n = await loadSeed(Astro.url.origin);
      msg = n ? `Se cargaron ${n} relojes.` : 'La vitrina ya tenía relojes.';
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

const relojes = hasDatabase() ? await listRelojes() : [];
const borradores = relojes.filter((r) => !r.publicado).length;
---

<AdminLayout title="Relojes">
  <div class="head">
    <div>
      <h1>Relojes</h1>
      <p class="muted">
        {relojes.length} en total · {relojes.length - borradores} publicados{borradores ? ` · ${borradores} sin publicar` : ''}
      </p>
    </div>
    <div class="row">
      <a class="btn" href="/admin/importar">Importar de Instagram</a>
      <a class="btn btn--primary" href="/admin/relojes/nuevo">+ Nuevo reloj</a>
    </div>
  </div>

  {msg && <p class="notice notice--ok">{msg}</p>}
  {error && <p class="notice notice--error">{error}</p>}

  {
    !hasDatabase() && (
      <div class="notice">
        <b>Falta conectar la base de datos.</b>
        <p>
          En Vercel, ve a <b>Storage → Neon</b>, conecta la base a este proyecto (eso crea <code>DATABASE_URL</code>) y vuelve
          a desplegar. Mientras tanto la página muestra la vitrina inicial.
        </p>
      </div>
    )
  }

  {
    hasDatabase() && relojes.length === 0 && (
      <div class="card empty">
        <h2>La vitrina está vacía</h2>
        <p class="muted">Puedes partir con los 7 relojes que tenía el sitio, o agregar los tuyos desde cero.</p>
        <form method="post">
          <input type="hidden" name="accion" value="seed" />
          <button class="btn btn--gold" type="submit">Cargar los 7 relojes actuales</button>
        </form>
      </div>
    )
  }

  <ul class="list">
    {
      relojes.map((r) => (
        <li class="item card" data-borrador={!r.publicado ? '' : undefined}>
          <a class="thumb" href={`/admin/relojes/${r.id}`}>
            {r.fotos[0] ? <img src={r.fotos[0].s} alt="" loading="lazy" /> : <span class="small muted">Sin foto</span>}
          </a>
          <div class="info">
            <div class="row">
              {!r.publicado && <span class="chip chip--borrador">Sin publicar</span>}
              <span class={`chip chip--${r.estado}`}>{estadoLabel[r.estado]}</span>
              <span class="small muted">Orden {r.orden}</span>
            </div>
            <a class="name" href={`/admin/relojes/${r.id}`}>
              <small>{r.marca}</small>
              <b>{r.modelo}</b>
            </a>
            <span class="small muted">
              {[r.referencia, r.medida, r.precio ? formatCLP(r.precio) : 'Precio por DM'].filter(Boolean).join(' · ')}
            </span>
            {r.instagram_url && (
              <a class="small" href={r.instagram_url} target="_blank" rel="noopener">
                Publicación de Instagram ↗
              </a>
            )}
          </div>
          <div class="actions">
            <form method="post" class="row">
              <input type="hidden" name="accion" value="estado" />
              <input type="hidden" name="id" value={r.id} />
              <label class="sr" for={`estado-${r.id}`}>Estado</label>
              <select id={`estado-${r.id}`} name="estado" onchange="this.form.requestSubmit()">
                {ESTADOS.map((e) => (
                  <option value={e} selected={e === r.estado}>
                    {estadoLabel[e]}
                  </option>
                ))}
              </select>
              <noscript>
                <button class="btn btn--sm">Guardar</button>
              </noscript>
            </form>
            <form method="post">
              <input type="hidden" name="accion" value={r.publicado ? 'ocultar' : 'publicar'} />
              <input type="hidden" name="id" value={r.id} />
              <button class={`btn btn--sm ${r.publicado ? '' : 'btn--gold'}`} type="submit" disabled={!r.publicado && !r.fotos.length}>
                {r.publicado ? 'Ocultar' : 'Publicar'}
              </button>
            </form>
            <a class="btn btn--sm" href={`/admin/relojes/${r.id}`}>Editar</a>
          </div>
        </li>
      ))
    }
  </ul>
</AdminLayout>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .item {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 12px;
  }
  .item[data-borrador] {
    border-style: dashed;
  }
  .thumb {
    width: 88px;
    height: 110px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--raised);
    display: grid;
    place-items: center;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .info {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .name {
    display: grid;
    color: var(--ink);
    text-decoration: none;
  }
  .name small {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }
  .name b {
    font-size: 17px;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .actions select {
    min-height: 34px;
    padding: 4px 8px;
    font-size: 13px;
  }
  .empty {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 640px) {
    .item {
      grid-template-columns: 72px minmax(0, 1fr);
    }
    .thumb {
      width: 72px;
      height: 90px;
    }
    .actions {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
