<script>
  import { calcularConsignacion, parseMonto } from '../lib/consignacion';
  import { formatCLP } from '../lib/relojes';
  import { whatsappUrl } from '../data/site';

  const input = document.getElementById('liquido') as HTMLInputElement;
  const out = (id: string) => document.getElementById(id)!;
  const cta = document.getElementById('calc-cta') as HTMLAnchorElement;
  const fmt = new Intl.NumberFormat('es-CL');

  function update() {
    const liquido = parseMonto(input.value);
    const r = calcularConsignacion(liquido);
    out('out-precio').textContent = formatCLP(r.precioVenta);
    out('out-comision').textContent = formatCLP(r.comision);
    out('out-liquido').textContent = formatCLP(r.liquido);
    cta.href = whatsappUrl(
      liquido
        ? `Hola, quiero consignar mi reloj y recibir ${formatCLP(r.liquido)} líquidos (precio de venta aprox. ${formatCLP(r.precioVenta)}). ¿Cómo partimos? Gracias`
        : 'Hola, quiero consignar mi reloj. ¿Me pueden contar cómo empezar? Gracias',
    );
  }

  input.addEventListener('input', () => {
    // Formatea con puntos de miles mientras se escribe, manteniendo el cursor al final.
    const n = parseMonto(input.value);
    input.value = n ? fmt.format(n) : '';
    update();
  });
  document.getElementById('calc')!.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>
