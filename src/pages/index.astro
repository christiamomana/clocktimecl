---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stories from '../components/Stories.astro';
import Collection from '../components/Collection.astro';
import Sell from '../components/Sell.astro';
import Included from '../components/Included.astro';
import Brands from '../components/Brands.astro';
import Story from '../components/Story.astro';
import Faq from '../components/Faq.astro';
import Valuation from '../components/Valuation.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getVitrina } from '../lib/server/relojes';

const relojes = await getVitrina();
// La CDN de Vercel guarda la página un minuto; los cambios del admin se ven en ~1 minuto.
Astro.response.headers.set('cache-control', 'public, s-maxage=60, stale-while-revalidate=600');
---

<Layout>
  <Header />
  <main id="top">
    <Hero />
    <Stories />
    <Collection relojes={relojes} />
    <Sell />
    <Included />
    <Brands />
    <Story />
    <Faq />
    <Valuation />
  </main>
  <Footer marcas={[...new Set(relojes.map((r) => r.marca))].slice(0, 5)} />
  <WhatsAppButton />
</Layout>
