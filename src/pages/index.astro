---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Dial from '../components/Dial.astro';
import ServiceBadge from '../components/ServiceBadge.astro';
import WatchCard from '../components/WatchCard.astro';
import StatusBanner from '../components/StatusBanner.astro';
import { brands, site } from '../data/site';
import { watches } from '../data/watches';
import type { IconName } from '../data/icons';

const pillars: { icon: IconName; label: [string, string] }[] = [
  { icon: 'search', label: ['Tasación', 'profesional'] },
  { icon: 'card', label: ['Pago al', 'instante'] },
  { icon: 'shield', label: ['Total', 'seguridad'] },
  { icon: 'handshake', label: ['Discreción', 'y confianza'] },
];

const steps: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'camera',
    title: 'Envíanos tu reloj',
    text: 'Escríbenos por DM con fotos de la pieza, su caja y papeles. Cuéntanos marca, modelo y referencia.',
  },
  {
    icon: 'search',
    title: 'Tasación profesional',
    text: 'Revisamos autenticidad, estado y mercado. Te damos una oferta clara, sin compromiso.',
  },
  {
    icon: 'cash',
    title: 'Pago inmediato',
    text: 'Si aceptas la oferta, te pagamos al instante. Rápido, seguro y sin complicaciones.',
  },
];

const consignment: { icon: IconName; label: [string, string] }[] = [
  { icon: 'shield', label: ['Operaciones', 'seguras'] },
  { icon: 'handshake', label: ['Confianza', 'comprobada'] },
  { icon: 'box', label: ['Envíos', 'seguros'] },
  { icon: 'pin', label: ['Concepción', '· Todo Chile'] },
];

const faqs = [
  {
    q: '¿Cómo sé que el reloj es auténtico?',
    a: 'Cada pieza pasa por una tasación profesional antes de publicarse. Siempre que existe, la entregamos con su caja y documentación original como prueba de autenticidad.',
  },
  {
    q: '¿Qué garantía tienen los relojes?',
    a: 'Las piezas que vendemos incluyen garantía de 3 meses. El detalle de cada una está en su ficha.',
  },
  {
    q: '¿Puedo pagar con tarjeta de crédito?',
    a: 'Sí. Puedes pagar con tarjeta de crédito hasta en 12 cuotas.',
  },
  {
    q: '¿Hacen envíos fuera de Concepción?',
    a: 'Sí, enviamos a todo Chile con envío seguro. También puedes coordinar una entrega en Concepción.',
  },
  {
    q: '¿Cuánto demora el pago si les vendo mi reloj?',
    a: 'Una vez aceptada la oferta y revisada la pieza, el pago es inmediato.',
  },
  {
    q: '¿Cómo consulto un precio?',
    a: 'Tus consultas y precios por DM en Instagram. Te respondemos con todo el detalle de la pieza.',
  },
];
---

<Layout>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero" id="inicio">
      <div class="container hero__inner">
        <div class="hero__copy">
          <span class="eyebrow">Alta relojería · {site.location} | {site.coverage}</span>
          <h1 class="display-lg">
            Compra y venta de relojes
            <span class="ct-foil-text">de alta gama</span>
          </h1>
          <p class="hero__lead">
            Tasación profesional, pago inmediato y venta con garantía. Compramos, vendemos y consignamos piezas de
            Rolex, Omega, Tudor, Panerai y más.
          </p>
          <div class="hero__ctas">
            <Button href="#catalogo">Ver catálogo</Button>
            <Button variant="outline" href="#vender">Tasar mi reloj</Button>
          </div>
          <p class="hero__sign">{site.tagline}</p>
        </div>
        <div class="hero__art" aria-hidden="true">
          <div class="hero__medal">
            <Dial size={320} />
          </div>
        </div>
      </div>

      <div class="container">
        <ul class="pillars" aria-label="Nuestros pilares">
          {
            pillars.map((p) => (
              <li>
                <ServiceBadge icon={p.icon} label={p.label} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Catálogo -->
    <section class="section section--raised" id="catalogo">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Catálogo</span>
          <h2 class="display-lg">Piezas <span class="ct-foil-text">disponibles</span></h2>
          <p>
            Cada reloj se entrega con su caja, documentación y garantía. ¿Lo incorporarías a tu colección? Tus consultas
            y precios por DM.
          </p>
        </div>
        <div class="grid-cards">
          {watches.map((w) => <WatchCard watch={w} />)}
        </div>
        <div class="frame-card ct-frame">
          <Icon name="card" size={28} class="frame-card__icon" />
          <div>
            <p class="headline">También vendemos con tarjeta de crédito</p>
            <p class="muted body-sm">Pago con tarjeta de crédito hasta 12 cuotas.</p>
          </div>
          <Button variant="outline" href={site.instagram.dm}>Consultar</Button>
        </div>
      </div>
    </section>

    <!-- Vender -->
    <section class="section" id="vender">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="eyebrow">Vende tu reloj</span>
          <h2 class="display-lg">Compramos <span class="ct-foil-text">tu reloj</span></h2>
          <p class="headline">Pago inmediato</p>
          <p>Rápido, seguro y sin complicaciones. Así funciona:</p>
        </div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="step">
                <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="ct-service__icon">
                  <Icon name={s.icon} size={22} />
                </span>
                <h3 class="step__title">{s.title}</h3>
                <p class="body-sm muted">{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="center">
          <Button href={site.instagram.dm}>
            <Icon name="message" size={18} />
            Cotiza por DM
          </Button>
        </div>
      </div>
    </section>

    <!-- Consignación -->
    <section class="section section--raised" id="consignacion">
      <div class="container split">
        <div class="section-head split__copy">
          <span class="eyebrow">Consignación</span>
          <h2 class="display-lg">Vendemos <span class="ct-foil-text">por ti</span></h2>
          <p>
            ¿Prefieres obtener el mejor precio sin hacer el trabajo? Deja tu reloj en consignación: lo tasamos, lo
            fotografiamos y lo presentamos a nuestra comunidad de coleccionistas con total discreción. Te pagamos cuando
            la pieza encuentra a su nuevo dueño.
          </p>
          <div>
            <Button variant="outline" href={site.instagram.dm}>Consignar mi reloj</Button>
          </div>
        </div>
        <ul class="badges-col">
          {
            consignment.map((c) => (
              <li>
                <ServiceBadge icon={c.icon} label={c.label} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Marcas -->
    <section class="section brands-section" aria-labelledby="marcas-title">
      <div class="container">
        <div class="rule"><span class="eyebrow" id="marcas-title">Marcas que compramos y vendemos</span></div>
        <ul class="brands">
          {brands.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </section>

    <!-- Vendidos -->
    <section class="section section--raised sold">
      <div class="container sold__inner">
        <div class="sold__banner">
          <StatusBanner />
        </div>
        <div class="section-head sold__copy">
          <span class="eyebrow">Vendidos</span>
          <h2 class="title">Este reloj ya encontró un nuevo dueño</h2>
          <p>
            Cada venta es una historia que continúa. Si buscas una pieza que ya se fue, escríbenos: te avisamos cuando
            llegue una igual.
          </p>
          <div>
            <Button variant="ghost" href={site.instagram.url}>
              Ver más en Instagram
              <Icon name="arrow" size={18} />
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="preguntas">
      <div class="container faq-wrap">
        <div class="section-head">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2 class="display-lg">Compra con <span class="ct-foil-text">confianza</span></h2>
        </div>
        <div class="faq">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="section contact" id="contacto">
      <div class="container">
        <div class="contact__box">
          <Dial size={72} class="contact__dial" />
          <span class="eyebrow">Contacto</span>
          <h2 class="display-lg">Tus consultas y precios <span class="ct-foil-text">por DM</span></h2>
          <p class="muted">
            Atendemos en {site.location} y enviamos a {site.coverage.toLowerCase()}. {site.signature}
          </p>
          <div class="hero__ctas">
            <Button href={site.instagram.dm}>
              <Icon name="instagram" size={18} />
              Escríbenos por DM
            </Button>
            <Button variant="outline" href={site.instagram.url}>{site.instagram.handle}</Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-12) var(--space-12);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 70% at 78% 35%, var(--surface-raised) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: calc(var(--space-12) * 2) var(--space-12);
    }

    .hero__inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .hero__copy {
    display: grid;
    gap: var(--space-6);
  }

  .hero__copy h1 .ct-foil-text {
    display: block;
  }

  .hero__lead {
    margin: 0;
    max-width: 520px;
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 28px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__sign {
    margin: 0;
    font: 500 15px/1.4 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .hero__art {
    display: grid;
    place-items: center;
  }

  .hero__medal {
    padding: var(--space-6);
    border-radius: var(--radius-full);
    background: var(--bg);
    box-shadow: var(--shadow-gold-glow), var(--shadow-card);
    width: min(100%, 380px);
  }

  .hero__medal :global(svg) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 899px) {
    .hero__art {
      order: -1;
    }

    .hero__medal {
      width: min(60%, 240px);
      padding: var(--space-3);
    }
  }

  .pillars {
    position: relative;
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: var(--space-8) 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6);
  }

  /* Catálogo */
  .grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: var(--space-6);
  }

  .frame-card {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }

  .frame-card > div {
    flex: 1 1 260px;
  }

  .frame-card p {
    margin: 0;
  }

  .frame-card :global(.frame-card__icon) {
    color: var(--gold);
    flex: none;
  }

  /* Pasos */
  .steps {
    list-style: none;
    margin: 0 0 var(--space-12);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-6);
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-8) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .step p {
    margin: 0;
  }

  .step__num {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    font: 600 28px/1 var(--font-display);
    color: var(--line);
  }

  .step__title {
    margin: 0;
    font: 600 20px/26px var(--font-display);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .center {
    display: flex;
    justify-content: center;
  }

  /* Consignación */
  .split {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-12);
    }
  }

  .split__copy {
    margin-bottom: 0;
  }

  .badges-col {
    list-style: none;
    margin: 0;
    padding: var(--space-8);
    display: grid;
    gap: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  /* Marcas */
  .brands-section {
    padding-block: var(--space-12);
  }

  .brands {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-8);
  }

  .brands li {
    font: 500 clamp(16px, 2.4vw, 22px) / 1.2 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Vendidos */
  .sold__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 900px) {
    .sold__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sold__banner {
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--space-4);
    min-height: 280px;
    border-radius: var(--radius-md);
    background: radial-gradient(circle at 50% 50%, var(--surface-raised) 0%, var(--bg) 75%);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .sold__copy {
    margin-bottom: 0;
  }

  /* FAQ */
  .faq-wrap {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .faq-wrap {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-12);
      align-items: start;
    }
  }

  .faq {
    border-top: 1px solid var(--line);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 16px;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    flex: none;
    font: 400 24px/1 var(--font-sans);
    color: var(--gold);
    transition: transform 0.2s ease;
  }

  .faq details[open] summary::after {
    transform: rotate(45deg);
  }

  .faq summary:hover {
    color: var(--gold-text);
  }

  .faq details p {
    margin: 0 0 var(--space-6);
    color: var(--ink-muted);
    max-width: 60ch;
  }

  /* Contacto */
  .contact__box {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: radial-gradient(70% 90% at 50% 0%, var(--surface-raised) 0%, var(--surface) 70%);
  }

  .contact__box p {
    margin: 0;
    max-width: 520px;
  }

  .contact__box .hero__ctas {
    justify-content: center;
  }
</style>
