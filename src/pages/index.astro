---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stories from '../components/Stories.astro';
import Collection from '../components/Collection.astro';
import Sell from '../components/Sell.astro';
import Included from '../components/Included.astro';
import Brands from '../components/Brands.astro';
import Story from '../components/Story.astro';
import Faq from '../components/Faq.astro';
import Valuation from '../components/Valuation.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="top">
    <Hero />
    <Stories />
    <Collection />
    <Sell />
    <Included />
    <Brands />
    <Story />
    <Faq />
    <Valuation />
  </main>
  <Footer />
</Layout>

<script>
  // Aparición al hacer scroll: solo lo que empieza bajo el primer pantallazo.
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.remove('is-waiting');
            io.unobserve(e.target);
          }
        }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => {
      if (el.getBoundingClientRect().top > innerHeight) {
        el.classList.add('is-waiting');
        io.observe(el);
      }
    });
  }
</script>
