---
// Reloj ilustrado de /historia: la esfera al frente y el mecanismo detrás. Las agujas las mueve
// el script de la página según el avance de la lectura; el segundero corre en tiempo real.
interface Props {
  size?: number;
  class?: string;
}

const { size = 360, class: className } = Astro.props;
// Ids propios por instancia: en móvil la copia grande está oculta y sus degradados no se pintarían.
const uid = `sw${Math.random().toString(36).slice(2, 8)}`;

const f = (n: number) => n.toFixed(2);
const at = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [100 + r * Math.sin(a), 100 - r * Math.cos(a)] as const;
};

const indices = Array.from({ length: 60 }, (_, i) => {
  const hour = i % 5 === 0;
  const [x1, y1] = at(i * 6, hour ? 66 : 72);
  const [x2, y2] = at(i * 6, 77);
  return { x1: f(x1), y1: f(y1), x2: f(x2), y2: f(y2), hour, major: i % 15 === 0 };
});

/** Contorno de un engranaje de `teeth` dientes centrado en (cx, cy). */
function gear(cx: number, cy: number, r: number, teeth: number, depth = 4) {
  const pts: string[] = [];
  const step = 360 / teeth;
  for (let t = 0; t < teeth; t++) {
    for (const [off, rr] of [[0, r - depth], [step * 0.18, r], [step * 0.5, r], [step * 0.68, r - depth]] as const) {
      const a = ((t * step + off) * Math.PI) / 180;
      pts.push(`${f(cx + rr * Math.cos(a))},${f(cy + rr * Math.sin(a))}`);
    }
  }
  return `M${pts.join('L')}Z`;
}

const gears = [
  { cx: 82, cy: 92, r: 34, teeth: 30, dur: 40, dir: 1 },
  { cx: 128, cy: 70, r: 18, teeth: 16, dur: 21, dir: -1 },
  { cx: 126, cy: 124, r: 22, teeth: 20, dur: 27, dir: -1 },
  { cx: 92, cy: 140, r: 12, teeth: 12, dur: 14, dir: 1 },
].map((g) => ({ ...g, d: gear(g.cx, g.cy, g.r, g.teeth) }));
---

<div class:list={['sw', className]} style={`--sw:${size}px`} data-story-watch data-face="esfera" aria-hidden="true">
  <div class="sw__inner">
    <svg class="sw__face sw__front" viewBox="0 0 200 200">
      <defs>
        <linearGradient id={`${uid}-gold`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f1dca2"></stop>
          <stop offset="0.5" stop-color="#c9a45c"></stop>
          <stop offset="1" stop-color="#7a5c24"></stop>
        </linearGradient>
        <radialGradient id={`${uid}-dial`} cx="0.5" cy="0.38" r="0.7">
          <stop offset="0" stop-color="#1e1b17"></stop>
          <stop offset="1" stop-color="#0b0b0c"></stop>
        </radialGradient>
      </defs>
      <circle cx="100" cy="100" r="98" fill={`url(#${uid}-gold)`}></circle>
      <circle cx="100" cy="100" r="90" fill="#0b0b0c"></circle>
      <circle cx="100" cy="100" r="86" fill={`url(#${uid}-dial)`}></circle>
      {
        indices.map((t) => (
          <line
            x1={t.x1}
            y1={t.y1}
            x2={t.x2}
            y2={t.y2}
            stroke={t.hour ? '#e6cd8e' : '#6b5a3a'}
            stroke-width={t.major ? 3.2 : t.hour ? 2 : 0.8}
            stroke-linecap="square"
          />
        ))
      }
      <text x="100" y="58" text-anchor="middle" fill="#c9a45c" font-family="Cinzel, Georgia, serif" font-size="9" letter-spacing="2.5">CLOCK TIME</text>
      <text x="100" y="146" text-anchor="middle" fill="#8c7a58" font-family="Montserrat, Arial, sans-serif" font-size="5" letter-spacing="2.2">CHILE · CONCEPCIÓN</text>
      <g class="sw__hand" data-hand="hour">
        <path d="M100 104 L97.4 100 L100 54 L102.6 100 Z" fill="#e6cd8e"></path>
      </g>
      <g class="sw__hand" data-hand="minute">
        <path d="M100 106 L98.2 100 L100 30 L101.8 100 Z" fill="#f3ede2"></path>
      </g>
      <g class="sw__hand sec-hand">
        <line x1="100" y1="114" x2="100" y2="26" stroke="#c9a45c" stroke-width="0.9"></line>
      </g>
      <circle cx="100" cy="100" r="3.4" fill="#c9a45c"></circle>
      <circle cx="100" cy="100" r="1.2" fill="#0b0b0c"></circle>
    </svg>

    <svg class="sw__face sw__back" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="98" fill={`url(#${uid}-gold)`}></circle>
      <circle cx="100" cy="100" r="90" fill="#16130f"></circle>
      <circle cx="100" cy="100" r="88" fill="none" stroke="#3a3122" stroke-width="0.8"></circle>
      {
        gears.map((g) => (
          <g class="sw__gear" style={`--cx:${g.cx}px;--cy:${g.cy}px;--dur:${g.dur}s;--dir:${g.dir}`}>
            <path d={g.d} fill="#b8924d" stroke="#7a5c24" stroke-width="0.6" />
            <circle cx={g.cx} cy={g.cy} r={g.r * 0.62} fill="#16130f" />
            {[0, 60, 120].map((a) => {
              const rad = (a * Math.PI) / 180;
              const rr = g.r * 0.62;
              return (
                <line
                  x1={f(g.cx - rr * Math.cos(rad))}
                  y1={f(g.cy - rr * Math.sin(rad))}
                  x2={f(g.cx + rr * Math.cos(rad))}
                  y2={f(g.cy + rr * Math.sin(rad))}
                  stroke="#b8924d"
                  stroke-width="1.6"
                />
              );
            })}
            <circle cx={g.cx} cy={g.cy} r="2.4" fill="#8f2b2b" stroke="#e6cd8e" stroke-width="0.6" />
          </g>
        ))
      }
      <g class="sw__balance">
        <circle cx="62" cy="142" r="15" fill="none" stroke="#e6cd8e" stroke-width="1.4"></circle>
        <line x1="47" y1="142" x2="77" y2="142" stroke="#e6cd8e" stroke-width="1"></line>
        <line x1="62" y1="127" x2="62" y2="157" stroke="#e6cd8e" stroke-width="1"></line>
      </g>
      <circle cx="62" cy="142" r="2" fill="#8f2b2b"></circle>
      <text x="100" y="182" text-anchor="middle" fill="#8c7a58" font-family="Montserrat, Arial, sans-serif" font-size="5" letter-spacing="2">HECHO A MANO</text>
    </svg>
  </div>
</div>

<style>
  .sw {
    width: var(--sw);
    max-width: 100%;
    aspect-ratio: 1;
    perspective: 1200px;
  }

  .sw__inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1.1s cubic-bezier(0.22, 0.7, 0.18, 1);
  }

  .sw[data-face='mecanismo'] .sw__inner {
    transform: rotateY(180deg);
  }

  .sw__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 50%;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.45));
  }

  .sw__back {
    transform: rotateY(180deg);
  }

  .sw__hand {
    transform-box: view-box;
    transform-origin: 100px 100px;
  }

  .sw[data-paused] .sec-hand {
    animation-play-state: paused;
  }

  .sw__gear {
    transform-box: view-box;
    transform-origin: var(--cx) var(--cy);
  }

  .sw__balance {
    transform-box: view-box;
    transform-origin: 62px 142px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sw__gear {
      animation: sw-spin var(--dur) linear infinite;
      animation-direction: normal;
    }

    .sw__gear[style*='--dir:-1'] {
      animation-direction: reverse;
    }

    .sw__balance {
      animation: sw-swing 0.8s ease-in-out infinite alternate;
    }
  }

  @keyframes sw-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sw-swing {
    from {
      transform: rotate(-110deg);
    }
    to {
      transform: rotate(110deg);
    }
  }
</style>
