---
import { askLabel, askMessage, estadoLabel, formatCLP, fotoSrcset, type FotoView, type Reloj } from '../lib/relojes';
import { site, whatsappUrl } from '../data/site';

interface Props {
  relojes: Reloj[];
}

const { relojes } = Astro.props;
const first = relojes[0];
const precioLabel = (r: Reloj) => (r.precio ? formatCLP(r.precio) : '');
const fichaSizes = '(max-width: 900px) 100vw, 55vw';

// Marcas con su cantidad, de la más numerosa a la menos: Panerai (6), Omega (4), Rolex (3)…
const marcas = [...relojes.reduce((m, r) => m.set(r.marca, (m.get(r.marca) ?? 0) + 1), new Map<string, number>())].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es'),
);

// Datos para cambiar la ficha en el navegador sin recargar.
const fichas = relojes.map((r) => ({
  marca: r.marca,
  modelo: r.modelo,
  descripcion: r.descripcion,
  especificaciones: r.especificaciones,
  incluye: r.incluye,
  ask: askLabel(r),
  askUrl: whatsappUrl(askMessage(r)),
  precio: precioLabel(r),
  encuadre: r.encuadre,
  fotos: r.fotos.map((f) => ({ srcset: fotoSrcset(f), src: f.m, ancho: f.ancho, alto: f.alto })),
}));

const img = (f: FotoView, sizes: string, alt: string, encuadre: string, eager = false) => ({
  src: f.m,
  srcset: fotoSrcset(f),
  sizes,
  width: f.ancho,
  height: f.alto,
  alt,
  loading: eager ? ('eager' as const) : ('lazy' as const),
  decoding: 'async' as const,
  style: `object-position:${encuadre}`,
});
---

<section class="coll" id="coleccion" aria-labelledby="collTitle">
  <div class="coll__head wrap center reveal">
    <span class="eyebrow" style="color:var(--gold-ink)">Relojes Clock Time</span>
    <h2 id="collTitle">La selección</h2>
    <p>Relojes reales de nuestra vitrina, con su caja y sus papeles. Toca uno para ver su ficha.</p>
  </div>
  {
    relojes.length === 0 ? (
      <p class="wrap center coll__empty">
        Estamos preparando nuevos relojes. Escríbenos y te contamos qué tenemos disponible.
      </p>
    ) : (
      <div class="rail">
        {marcas.length > 1 && (
          <div class="filters wrap" id="filters" role="group" aria-label="Filtrar por marca">
            <button type="button" class="filter" data-marca="" aria-pressed="true">
              Todos <span>({relojes.length})</span>
            </button>
            {marcas.map(([marca, n]) => (
              <button type="button" class="filter" data-marca={marca} aria-pressed="false">
                {marca} <span>({n})</span>
              </button>
            ))}
          </div>
        )}
        <div class="rail__track wrap" id="track" role="group" aria-label="Relojes">
          {relojes.map((r, i) => (
            <button class="tile" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i} data-marca={r.marca}>
              {r.estado !== 'disponible' ? (
                <span class="tag tag--sold">{estadoLabel[r.estado]}</span>
              ) : (
                r.etiqueta && <span class="tag">{r.etiqueta}</span>
              )}
              <div class="tile__art">
                <img {...img(r.fotos[0], '(max-width: 700px) 70vw, 340px', `${r.marca} ${r.modelo}`, r.encuadre)} />
              </div>
              <small>{r.marca}</small>
              <b>{r.modelo}</b>
              <span class="tnum">{[r.referencia, r.medida].filter(Boolean).join(' · ')}</span>
              {r.precio && <span class="tile__price tnum">{formatCLP(r.precio)}</span>}
            </button>
          ))}
        </div>
        <div class="rail__nav wrap">
          <div class="rail__prog" aria-hidden="true"><i id="prog" /></div>
          <div class="rail__btns">
            <button class="circle" id="prev" aria-label="Anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button class="circle" id="next" aria-label="Siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>
      </div>
    )
  }
</section>

{
  first && (
    <section class="piece" id="ficha" aria-labelledby="pTitle">
      <div class="piece__grid">
        <div class="piece__art" id="pArtBox" aria-roledescription="carrusel" aria-label="Fotos del reloj">
          <div class="gal" id="pArt" tabindex="0">
            {first.fotos.map((f, i) => (
              <div class="gal__slide" aria-label={`Foto ${i + 1} de ${first.fotos.length}`}>
                <img {...img(f, fichaSizes, `${first.marca} ${first.modelo}, foto ${i + 1}`, i === 0 ? first.encuadre : '50% 50%', i === 0)} />
              </div>
            ))}
          </div>
          <button class="gal__btn gal__btn--prev" id="pPrev" type="button" aria-label="Foto anterior" hidden={first.fotos.length < 2}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button class="gal__btn gal__btn--next" id="pNext" type="button" aria-label="Foto siguiente" hidden={first.fotos.length < 2}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
          <span class="gal__count tnum" id="pCount" aria-live="polite" hidden={first.fotos.length < 2}>1 / {first.fotos.length}</span>
          <div class="piece__thumbs" id="pThumbs" hidden={first.fotos.length < 2}>
            {first.fotos.map((f, i) => (
              <button type="button" data-f={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Foto ${i + 1}`}>
                <img src={f.s} alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>
        <div class="piece__txt">
          <span class="eyebrow" id="pBrand">{first.marca}</span>
          <h2 id="pTitle">{first.modelo}</h2>
          <p class="desc" id="pDesc">{first.descripcion}</p>
          <dl class="specs tnum" id="pSpecs">
            {first.especificaciones.slice(0, 4).map((s) => (
              <div>
                <dt>{s.nombre}</dt>
                <dd>{s.valor}</dd>
              </div>
            ))}
          </dl>
          <div class="incl-list" id="pIncl">
            {first.incluye.map((x) => <span>{x}</span>)}
          </div>
          <p class="piece__price tnum" id="pPrice" hidden={!first.precio}>{precioLabel(first)}</p>
          <div class="actions">
            <a class="pill pill--gold" id="pAsk" href={whatsappUrl(askMessage(first))} target="_blank" rel="noopener">
              {askLabel(first)}
            </a>
            <a class="pill pill--glass" href={site.instagram} target="_blank" rel="noopener">Ver en Instagram</a>
          </div>
          <p class="piece__note">Te respondemos por WhatsApp. Pago con tarjeta hasta 12 cuotas.</p>
        </div>
      </div>
      <script type="application/json" id="fichas-data" set:html={JSON.stringify(fichas).replace(/</g, '\\u003c')} />
    </section>
  )
}

<style>
  .filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 20px;
    justify-content: safe center;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: none;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    border: 0;
    cursor: pointer;
    font: 600 14px var(--font-sans);
    background: rgba(23, 20, 15, 0.07);
    color: var(--ink);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .filter span {
    font-weight: 500;
    opacity: 0.7;
  }

  .filter:hover {
    background: rgba(23, 20, 15, 0.13);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--ivory);
  }

  .tile__price {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 700;
    color: var(--gold-ink);
  }

  .coll__empty {
    color: var(--ink-2);
    font-size: var(--t-lead);
  }

  /* Carrusel de fotos de la ficha: deslizar en móvil, flechas en escritorio */
  .gal {
    position: absolute;
    inset: 0;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    transition: opacity 0.4s var(--ease), transform 1s var(--ease);
  }

  .gal::-webkit-scrollbar {
    display: none;
  }

  .gal:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: -4px;
  }

  .piece__art.is-out .gal {
    opacity: 0;
    transform: scale(1.04);
  }

  .gal :global(.gal__slide) {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .gal :global(.gal__slide img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gal__btn {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: -24px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    background: rgba(11, 11, 12, 0.55);
    color: var(--on-night);
    backdrop-filter: blur(6px);
    transition: background-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }

  .gal__btn:hover {
    background: rgba(11, 11, 12, 0.85);
  }

  .gal__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .gal__btn svg {
    width: 18px;
    height: 18px;
  }

  .gal__btn--prev {
    left: 16px;
  }

  .gal__btn--next {
    right: 16px;
  }

  .gal__count {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(11, 11, 12, 0.6);
    color: var(--on-night);
    font-size: 13px;
    font-weight: 600;
  }

  @media (hover: none) {
    .gal__btn {
      display: none;
    }
  }

  .piece__thumbs {
    position: absolute;
    left: 16px;
    bottom: 16px;
    right: 16px;
    z-index: 1;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .piece__thumbs :global(button) {
    flex: none;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.7;
    box-shadow: 0 0 0 1px rgba(243, 237, 226, 0.3);
    transition: opacity 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .piece__thumbs :global(button[aria-pressed='true']),
  .piece__thumbs :global(button:hover) {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--gold);
  }

  .piece__thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .piece__price {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 700;
    color: var(--gold-night);
  }
</style>

<script>
  interface Ficha {
    marca: string;
    modelo: string;
    descripcion: string;
    especificaciones: { nombre: string; valor: string }[];
    incluye: string[];
    ask: string;
    askUrl: string;
    precio: string;
    encuadre: string;
    fotos: { srcset: string; src: string; ancho: number; alto: number }[];
  }

  const $ = (id: string) => document.getElementById(id);
  const track = $('track');
  const art = $('pArt');
  const thumbs = $('pThumbs');
  const fichas: Ficha[] = JSON.parse($('fichas-data')?.textContent || '[]');
  let current = 0;

  const el = (tag: string, text: string) => {
    const n = document.createElement(tag);
    n.textContent = text;
    return n;
  };

  const prev = $('pPrev') as HTMLButtonElement | null;
  const next = $('pNext') as HTMLButtonElement | null;
  const count = $('pCount');
  let photoIndex = 0;

  const slideCount = () => art?.children.length ?? 0;

  /** Marca la foto visible: contador, miniatura activa y estado de las flechas. */
  function markPhoto(i: number) {
    photoIndex = i;
    const n = slideCount();
    if (count) count.textContent = `${i + 1} / ${n}`;
    if (prev) prev.disabled = i <= 0;
    if (next) next.disabled = i >= n - 1;
    thumbs?.querySelectorAll<HTMLElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === String(i))));
    const active = thumbs?.querySelector<HTMLElement>(`button[data-f="${i}"]`);
    if (active && thumbs) thumbs.scrollTo({ left: active.offsetLeft - thumbs.clientWidth / 2 + active.clientWidth / 2, behavior: 'smooth' });
  }

  function goTo(i: number, smooth = true) {
    if (!art) return;
    const target = Math.max(0, Math.min(slideCount() - 1, i));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    art.scrollTo({ left: target * art.clientWidth, behavior: smooth && !reduce ? 'smooth' : 'auto' });
    markPhoto(target);
  }

  /** Arma el carrusel de un reloj: una diapositiva por foto, la primera con su encuadre. */
  function renderGallery(f: Ficha) {
    if (!art) return;
    art.replaceChildren(
      ...f.fotos.map((p, i) => {
        const slide = document.createElement('div');
        slide.className = 'gal__slide';
        slide.setAttribute('aria-label', `Foto ${i + 1} de ${f.fotos.length}`);
        const img = document.createElement('img');
        Object.assign(img, {
          src: p.src,
          srcset: p.srcset,
          width: p.ancho,
          height: p.alto,
          alt: `${f.marca} ${f.modelo}, foto ${i + 1}`,
          decoding: 'async',
          loading: i === 0 ? 'eager' : 'lazy',
        });
        img.sizes = '(max-width: 900px) 100vw, 55vw';
        img.style.objectPosition = i === 0 ? f.encuadre : '50% 50%';
        slide.append(img);
        return slide;
      }),
    );
    const many = f.fotos.length > 1;
    [prev, next, count, thumbs].forEach((n) => n && (n.hidden = !many));
    renderThumbs(f);
    art.scrollTo({ left: 0, behavior: 'auto' });
    markPhoto(0);
  }

  // Al deslizar con el dedo, actualiza la foto marcada según la posición del carrusel.
  let scrollTimer = 0;
  art?.addEventListener(
    'scroll',
    () => {
      clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const i = Math.round(art.scrollLeft / Math.max(1, art.clientWidth));
        if (i !== photoIndex) markPhoto(i);
      }, 80);
    },
    { passive: true },
  );
  prev?.addEventListener('click', () => goTo(photoIndex - 1));
  next?.addEventListener('click', () => goTo(photoIndex + 1));
  art?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      goTo(photoIndex - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      goTo(photoIndex + 1);
    }
  });
  addEventListener('resize', () => goTo(photoIndex, false));

  function renderThumbs(f: Ficha) {
    if (!thumbs) return;
    thumbs.hidden = f.fotos.length < 2;
    thumbs.replaceChildren(
      ...f.fotos.map((p, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.f = String(i);
        b.setAttribute('aria-label', `Foto ${i + 1}`);
        b.setAttribute('aria-pressed', String(i === 0));
        const img = document.createElement('img');
        img.src = p.src;
        img.alt = '';
        b.append(img);
        return b;
      }),
    );
  }

  function show(i: number, scroll = true) {
    const f = fichas[i];
    if (!f || !art || !track) return;
    current = i;
    track.querySelectorAll<HTMLElement>('.tile').forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.i === String(i))));
    const box = $('pArtBox')!;
    box.classList.add('is-out');
    setTimeout(() => {
      renderGallery(f);
      $('pBrand')!.textContent = f.marca;
      $('pTitle')!.textContent = f.modelo;
      $('pDesc')!.textContent = f.descripcion;
      $('pSpecs')!.replaceChildren(
        ...f.especificaciones.slice(0, 4).map(({ nombre, valor }) => {
          const d = document.createElement('div');
          d.append(el('dt', nombre), el('dd', valor));
          return d;
        }),
      );
      $('pIncl')!.replaceChildren(...f.incluye.map((x) => el('span', x)));
      const price = $('pPrice')!;
      price.textContent = f.precio;
      price.hidden = !f.precio;
      const ask = $('pAsk') as HTMLAnchorElement;
      ask.textContent = f.ask;
      ask.href = f.askUrl;
      box.classList.remove('is-out');
    }, 280);
    if (!scroll) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    $('ficha')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
  }

  // Filtro por marca: oculta los relojes de otras marcas y muestra en la ficha el primero que queda.
  $('filters')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter');
    if (!btn || !track) return;
    const marca = btn.dataset.marca ?? '';
    $('filters')!.querySelectorAll('.filter').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    let first: number | null = null;
    track.querySelectorAll<HTMLElement>('.tile').forEach((t) => {
      const visible = !marca || t.dataset.marca === marca;
      t.hidden = !visible;
      if (visible && first === null) first = Number(t.dataset.i);
    });
    track.scrollTo({ left: 0 });
    track.dispatchEvent(new Event('scroll'));
    if (first !== null && first !== current) show(first, false);
  });

  thumbs?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('button[data-f]');
    if (b) goTo(Number(b.dataset.f));
  });
  markPhoto(0);

  if (track) {
    track.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (t) show(Number(t.dataset.i));
    });
    const prog = $('prog')!;
    const upd = () => {
      const m = track.scrollWidth - track.clientWidth;
      prog.style.transform = `scaleX(${m > 0 ? 0.2 + (0.8 * track.scrollLeft) / m : 1})`;
    };
    track.addEventListener('scroll', upd, { passive: true });
    addEventListener('resize', upd);
    upd();
    $('prev')?.addEventListener('click', () => track.scrollBy({ left: -360, behavior: 'smooth' }));
    $('next')?.addEventListener('click', () => track.scrollBy({ left: 360, behavior: 'smooth' }));
  }
</script>
