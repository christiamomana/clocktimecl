---
import { Picture } from 'astro:assets';
import { getRelojes, estadoLabel, askLabel } from '../lib/relojes';
import { site } from '../data/site';

const relojes = await getRelojes();
const first = relojes[0];
const fichaSizes = '(max-width: 900px) 100vw, 55vw';

// Datos de texto para cambiar la ficha en el navegador; las fotos van en <template> ya optimizadas.
const fichas = relojes.map(({ data }) => ({
  marca: data.marca,
  modelo: data.modelo,
  descripcion: data.descripcion,
  especificaciones: data.especificaciones,
  incluye: data.incluye,
  ask: askLabel(data.estado),
}));
---

<section class="coll" id="coleccion" aria-labelledby="collTitle">
  <div class="coll__head wrap center reveal">
    <span class="eyebrow" style="color:var(--gold-ink)">Relojes Clock Time</span>
    <h2 id="collTitle">La selección</h2>
    <p>Piezas reales de nuestra vitrina, con su caja y sus papeles. Toca una para ver su ficha.</p>
  </div>
  <div class="rail">
    <div class="rail__track wrap" id="track" role="group" aria-label="Piezas">
      {
        relojes.map(({ data }, i) => (
          <button class="tile" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>
            {data.estado !== 'disponible' ? (
              <span class="tag tag--sold">{estadoLabel[data.estado]}</span>
            ) : (
              data.etiqueta && <span class="tag">{data.etiqueta}</span>
            )}
            <div class="tile__art">
              <Picture
                src={data.imagen}
                formats={['avif']}
              fallbackFormat="webp"
                widths={[400, 720]}
                sizes="(max-width: 700px) 70vw, 340px"
                alt={`${data.marca} ${data.modelo}`}
                style={`object-position:${data.encuadre}`}
              />
            </div>
            <small>{data.marca}</small>
            <b>{data.modelo}</b>
            <span class="tnum">{data.referencia} · {data.medida}</span>
          </button>
        ))
      }
    </div>
    <div class="rail__nav wrap">
      <div class="rail__prog" aria-hidden="true"><i id="prog"></i></div>
      <div class="rail__btns">
        <button class="circle" id="prev" aria-label="Anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button class="circle" id="next" aria-label="Siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

{
  first && (
    <section class="piece" id="ficha" aria-labelledby="pTitle">
      <div class="piece__grid">
        <div class="piece__art" id="pArt">
          <Picture
            src={first.data.imagen}
            formats={['avif']}
              fallbackFormat="webp"
            widths={[720, 1100]}
            sizes={fichaSizes}
            alt={`${first.data.marca} ${first.data.modelo}`}
            style={`object-position:${first.data.encuadre}`}
            loading="eager"
          />
        </div>
        <div class="piece__txt">
          <span class="eyebrow" id="pBrand">{first.data.marca}</span>
          <h2 id="pTitle">{first.data.modelo}</h2>
          <p class="desc" id="pDesc">{first.data.descripcion}</p>
          <dl class="specs tnum" id="pSpecs">
            {first.data.especificaciones.map((s) => <div><dt>{s.nombre}</dt><dd>{s.valor}</dd></div>)}
          </dl>
          <div class="incl-list" id="pIncl">
            {first.data.incluye.map((x) => <span>{x}</span>)}
          </div>
          <div class="actions">
            <a class="pill pill--gold" id="pAsk" href={site.dm} target="_blank" rel="noopener">
              {askLabel(first.data.estado)}
            </a>
            <a class="pill pill--glass" href={site.instagram} target="_blank" rel="noopener">Ver en Instagram</a>
          </div>
          <p class="piece__note">Confirma la disponibilidad por DM. Pago con tarjeta hasta 12 cuotas.</p>
        </div>
      </div>
      {
        relojes.map(({ data }, i) => (
          <template data-ficha-pic={i}>
            <Picture
              src={data.imagen}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[720, 1100]}
              sizes={fichaSizes}
              alt={`${data.marca} ${data.modelo}`}
              style={`object-position:${data.encuadre}`}
              loading="eager"
            />
          </template>
        ))
      }
      <script type="application/json" id="fichas-data" set:html={JSON.stringify(fichas).replace(/</g, '\\u003c')} />
    </section>
  )
}

<script>
  interface Ficha {
    marca: string;
    modelo: string;
    descripcion: string;
    especificaciones: { nombre: string; valor: string }[];
    incluye: string[];
    ask: string;
  }

  const $ = (id: string) => document.getElementById(id)!;
  const track = $('track');
  const art = document.getElementById('pArt');
  const fichas: Ficha[] = JSON.parse(document.getElementById('fichas-data')?.textContent || '[]');

  const el = (tag: string, text: string) => {
    const n = document.createElement(tag);
    n.textContent = text;
    return n;
  };

  function show(i: number) {
    const f = fichas[i];
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-ficha-pic="${i}"]`);
    if (!f || !tpl || !art) return;
    track.querySelectorAll<HTMLElement>('.tile').forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.i === String(i))));
    art.classList.add('is-out');
    setTimeout(() => {
      art.replaceChildren(tpl.content.cloneNode(true));
      $('pBrand').textContent = f.marca;
      $('pTitle').textContent = f.modelo;
      $('pDesc').textContent = f.descripcion;
      $('pSpecs').replaceChildren(
        ...f.especificaciones.map(({ nombre, valor }) => {
          const d = document.createElement('div');
          d.append(el('dt', nombre), el('dd', valor));
          return d;
        }),
      );
      $('pIncl').replaceChildren(...f.incluye.map((x) => el('span', x)));
      $('pAsk').textContent = f.ask;
      art.classList.remove('is-out');
    }, 280);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    $('ficha').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
  }

  track.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('.tile');
    if (t) show(Number(t.dataset.i));
  });

  const prog = $('prog');
  const upd = () => {
    const m = track.scrollWidth - track.clientWidth;
    prog.style.transform = `scaleX(${m > 0 ? 0.2 + (0.8 * track.scrollLeft) / m : 1})`;
  };
  track.addEventListener('scroll', upd, { passive: true });
  addEventListener('resize', upd);
  upd();
  $('prev').addEventListener('click', () => track.scrollBy({ left: -360, behavior: 'smooth' }));
  $('next').addEventListener('click', () => track.scrollBy({ left: 360, behavior: 'smooth' }));
</script>
