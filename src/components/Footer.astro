---
import { site } from '../data/site';
import { getRelojes } from '../lib/relojes';

const marcas = [...new Set((await getRelojes()).map((r) => r.data.marca))].slice(0, 5);

const year = new Date().getFullYear();
const cols = [
  {
    title: 'Piezas',
    links: [...marcas.map((m) => [m, '#coleccion']), ['Toda la selección', '#coleccion']],
  },
  {
    title: 'Servicios',
    links: [
      ['Compra con pago inmediato', '#vender'], ['Consignación', '#preguntas'],
      ['Tasación profesional', '#tasar'], ['Garantía de 3 meses', '#garantia'],
    ],
  },
  {
    title: 'Clock Time',
    links: [['Nuestra historia', '#historia'], ['Preguntas frecuentes', '#preguntas'], ['Envíos a todo Chile', '#garantia']],
  },
  { title: 'Canales oficiales', links: [['WhatsApp', site.whatsapp], ['Instagram', site.instagram], ['Mensaje directo', site.dm]] },
];
---

<footer class="foot wrap">
  <div class="foot__cols">
    {
      cols.map((c) => (
        <div>
          <h4>{c.title}</h4>
          <ul>
            {c.links.map(([label, href]) => (
              <li>
                <a href={href} {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="foot__brand"><b>CLOCK TIME</b><span>Chile · Alta relojería</span></div>
  <div class="foot__meta">
    <span>Concepción, Biobío · {year}</span>
    <span>Fotografías: {site.handle}.</span>
    <span>Más que relojes, confianza.</span>
  </div>
</footer>
