---
const faqs = [
  {
    q: '¿Cómo tasan mi reloj?',
    a: 'Con fotos de la esfera, el fondo y los papeles, más la marca, la referencia y el año. Revisamos estado, originalidad y si conserva caja y documentación, y te damos un valor de mercado.',
  },
  { q: '¿El pago es realmente inmediato?', a: 'Sí. Cuando acordamos la compra y verificamos la pieza, te pagamos en el momento.' },
  {
    q: '¿Qué es la consignación?',
    a: 'Vendemos tu reloj por ti, a un precio acordado contigo. Cobramos un 10 % solo si se vende, firmamos un acuerdo y el reloj puede quedarse contigo mientras lo promocionamos.',
    link: { href: '/consignacion', label: 'Ver cómo funciona la consignación' },
  },
  {
    q: '¿Qué cubre la garantía?',
    a: 'Los relojes que vendemos tienen 3 meses de garantía de funcionamiento. Cada ficha indica qué incluye la pieza: reloj, caja y documentación.',
  },
  { q: '¿Puedo pagar en cuotas?', a: 'Sí, con tarjeta de crédito hasta 12 cuotas. Consulta las condiciones por DM.' },
  { q: '¿Envían fuera de Concepción?', a: 'Sí, a todo Chile, con envío seguro. También compramos relojes de otras ciudades.' },
];
---

<section class="faq wrap" id="preguntas" aria-labelledby="faqTitle">
  <div class="faq__in">
    <span class="eyebrow center" style="color:var(--gold-ink)">Ayuda</span>
    <h2 id="faqTitle" class="center">Preguntas frecuentes</h2>
    {
      faqs.map((f) => (
        <details>
          <summary>
            {f.q} <span class="pm" aria-hidden="true" />
          </summary>
          <div class="ans"><div><p>{f.a}</p>{f.link && <p><a href={f.link.href}>{f.link.label}</a></p>}</div></div>
        </details>
      ))
    }
  </div>
</section>
