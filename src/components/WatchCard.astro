---
import Button from './Button.astro';
import Dial from './Dial.astro';
import { site } from '../data/site';
import { formatCLP, type Watch } from '../data/watches';

interface Props {
  watch: Watch;
}

const { watch } = Astro.props;
const sold = watch.status === 'vendido';
---

<article class="ct-card">
  <div class="ct-card__media">
    {
      watch.image ? (
        <img src={watch.image} alt={`${watch.brand} ${watch.model} ${watch.reference}`} loading="lazy" />
      ) : (
        <Dial size={132} />
      )
    }
  </div>
  <div class="ct-card__body">
    <div class="ct-card__top">
      <span class="ct-card__eyebrow">{watch.brand} · {watch.reference}</span>
      {
        sold ? (
          <span class="ct-chip ct-chip--sold">Vendido</span>
        ) : (
          <span class="ct-chip ct-chip--available">Disponible</span>
        )
      }
    </div>
    <h3 class="ct-card__title">{watch.model}</h3>
    <ul class="ct-card__specs">
      {watch.specs.map((s) => <li>{s}</li>)}
    </ul>
    <hr class="ct-card__rule" />
    <ul class="ct-card__incl">
      {watch.includes.map((s) => <li>{s}</li>)}
    </ul>
    <div class="ct-card__foot">
      {
        sold ? (
          <span class="ct-card__price ct-card__price--sold">
            Vendido <small>Encontró un nuevo dueño</small>
          </span>
        ) : watch.price ? (
          <span class="ct-card__price">
            {formatCLP(watch.price)} <small>Hasta 12 cuotas con tarjeta</small>
          </span>
        ) : (
          <span class="ct-card__price">
            Consultar <small>Precio por DM</small>
          </span>
        )
      }
      {
        sold ? (
          <Button variant="outline" href={site.instagram.dm}>
            Busco uno así
          </Button>
        ) : (
          <Button href={site.instagram.dm}>Escríbenos</Button>
        )
      }
    </div>
  </div>
</article>

<style>
  .ct-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }

  .ct-card__price--sold {
    color: var(--ink-muted);
  }
</style>
