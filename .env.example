# Administrador en producción (Keystatic + GitHub). Ver README → "Administrador".
PUBLIC_KEYSTATIC_STORAGE=github
# Los genera el asistente de Keystatic al crear la GitHub App (no los subas al repo):
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
